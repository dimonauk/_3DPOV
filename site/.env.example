# =============================================================================
# Chrono-Protocol Archive — environment variables
#
# Copy to .env.local for dev. Set the same keys in Vercel Project Settings
# for production. No real secrets belong in this file.
# =============================================================================

# --- Public site -------------------------------------------------------------
# Canonical URL used by metadata, OG tags, robots.txt, sitemap.xml, and the
# Stripe success/cancel URLs. On Vercel this auto-fills from VERCEL_URL for
# preview deploys; set NEXT_PUBLIC_SITE_URL explicitly for production to lock
# in the custom domain.
NEXT_PUBLIC_SITE_URL=https://chrono-protocol.example

# --- Stripe ------------------------------------------------------------------
# Required to create real Checkout Sessions. If unset, /api/checkout falls
# back to a stub redirect so the site still deploys and renders correctly.
# Use test-mode keys (sk_test_…) while developing.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret. Obtain from Stripe Dashboard → Developers →
# Webhooks after pointing the endpoint at https://YOUR_DOMAIN/api/stripe/webhook
# and subscribing to "checkout.session.completed". Without this the webhook
# route returns 503 and ignores events.
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email) -------------------------------------------
# Required to send order-confirmation emails from the webhook. Without this,
# the webhook logs the skip and returns success (Stripe still marks the
# order paid). Domain must be verified in the Resend dashboard.
RESEND_API_KEY=
ORDER_FROM_EMAIL=studio@chrono-protocol.example

# Optional: BCC address that receives a copy of every order confirmation.
# Useful for a shared studio inbox.
ORDER_NOTIFICATION_EMAIL=
