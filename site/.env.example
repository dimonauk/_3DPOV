# =============================================================================
# Chrono-Protocol Archive — environment variables
#
# Copy to .env.local for dev. Set the same keys in Vercel Project Settings
# for production. No real secrets belong in this file.
# =============================================================================

# --- Public site -------------------------------------------------------------
# Canonical URL used by metadata, OG tags, robots.txt, sitemap.xml, and the
# Stripe success/cancel URLs. On Vercel this is auto-filled from VERCEL_URL
# for preview deploys, but set NEXT_PUBLIC_SITE_URL for production to lock in
# the custom domain.
NEXT_PUBLIC_SITE_URL=https://chrono-protocol.example

# --- Stripe ------------------------------------------------------------------
# Required to create real Checkout Sessions. If unset, /api/checkout falls
# back to a stub redirect so the site still deploys and renders correctly.
# Use test-mode keys (sk_test_…) while developing.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) — required once you wire the webhook
# handler at /api/stripe/webhook (not yet implemented).
STRIPE_WEBHOOK_SECRET=
