  "colour_attributes": ["SprottG_Speed"],
  "blender_version": "5.1",
  "licence": "CC0",
  "topic": "scripting",
  "attractor": {
    "system": "Sprott G",
    "equations": ["dx/dt = a*x + z", "dy/dt = x*z - y", "dz/dt = -x + y"],
    "canonical_params": {"a": 0.40},
    "divergence": "constant: a - 1 = -0.60",
    "fixed_points": [
      {"name": "O",  "coords": [0, 0, 0],      "type": "saddle-focus", "eigenvalues": [-1, "0.2±0.98i"]},
      {"name": "P*", "coords": [-2.5, -6.25, 2.5], "type": "saddle-focus"}
    ],
    "lyapunov": {"lambda1": 0.077, "lambda2": 0.0, "lambda3": -0.677, "D_KY": 2.114},
    "liouville_check": "0.077 + 0.0 - 0.677 = -0.600 = div F",
    "topology": "leaf-scroll single-lobe"
  },
  "integration": {
    "method": "RK4", "dt": 0.01,
    "burn_in": 2000, "N": 90000, "thin": 30, "waypoints": 3000
  },
  "tube": {"radius": 0.045, "sides": 8},
  "poi_head": {"radius": 0.090, "segments": 16, "rings": 8},
