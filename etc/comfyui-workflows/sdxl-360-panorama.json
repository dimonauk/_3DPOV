{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sdxl_360_diffusion.safetensors" },
    "_meta": { "title": "Load SDXL 360 Diffusion" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "equirectangular 360 panorama, an atmospheric outdoor scene, seamless spherical projection, ultra wide",
      "clip": ["1", 1]
    },
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "distorted, warped seams, blurry, low quality, watermark, text",
      "clip": ["1", 1]
    },
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 4096, "height": 2048, "batch_size": 1 },
    "_meta": { "title": "Empty Latent — 4096x2048 equirect (2:1)" }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": 360,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    },
    "_meta": { "title": "KSampler — SDXL Panorama" }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] },
    "_meta": { "title": "VAE Decode" }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "holoflow_sdxl_360_panorama"
    },
    "_meta": { "title": "Save Image" }
  }
}
