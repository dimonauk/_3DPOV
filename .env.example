# =============================================================================
# Holo-Flow Studio — environment variables
#
# Copy to .env.local for dev. Set the same keys in Vercel Project Settings
# for production. Never commit .env.local.
# =============================================================================

# --- Site identity -----------------------------------------------------------
SITE_NAME="Holo-Flow Studio"
COMPANY_NAME="Holo-Flow Studio"

# --- Shopify Storefront (required for anything to render) --------------------
# Staging (Shopify Partners dev store)
SHOPIFY_STORE_DOMAIN="holoflow-dev.myshopify.com"
# Production (swap at cutover):
# SHOPIFY_STORE_DOMAIN="holoflow.myshopify.com"

# Install the Headless app in Shopify admin, create a storefront, copy the
# Storefront API access token. Keep it read-only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Random shared secret. Generate with: openssl rand -hex 32
# Shopify webhooks include this as a query parameter when pinging
# /api/revalidate; the route rejects drive-by requests missing this.
SHOPIFY_REVALIDATION_SECRET=""

# --- 3D models (optional) ----------------------------------------------------
# Base URL for product GLB files. If unset, files resolve to
# /models/{product-handle}.glb served from public/models/. Point this at a
# CDN (e.g. Vercel Blob, Cloudflare R2) in production.
# NEXT_PUBLIC_MODEL_BASE_URL="https://cdn.holoflow.co.uk"

# --- Analytics (optional, no-ops until set) ---------------------------------
# Plausible: privacy-first, no cookie banner. Set to your canonical domain.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="holoflow.co.uk"

# Klaviyo: on-site tracking + embed script for signup forms / popups.
# Find your Company ID in Klaviyo → Account → Settings → API Keys.
# NEXT_PUBLIC_KLAVIYO_COMPANY_ID=""

# --- Transactional email (optional) -----------------------------------------
# When set, the /api/newsletter and /api/contact routes can forward to
# Klaviyo / Resend (today they just log to console).
# RESEND_API_KEY=""
# CONTACT_INBOX_EMAIL="contact@holoflow.co.uk"

# --- Aura's voice (audio.tts ElevenLabs provider) ----------------------------
# When set, `audio.tts` can route to the "elevenlabs" provider for
# studio-quality voice. Without it, audio.tts falls back to the browser's
# Web Speech API (always available, no API key, lower fidelity).
# Sign up at https://elevenlabs.io/. The free tier suffices for development.
# ELEVENLABS_API_KEY=""
# ELEVENLABS_DEFAULT_VOICE_ID=""

# --- Aura's voice (audio.tts local providers) --------------------------------
# Kokoro is the local TTS service surfaced by the Hangar's VRM AI bridge
# (`docs/LOCAL_SERVICES.md`). When unset, the kokoro provider defaults to
# http://localhost:8888 (Aura-Alive HTTP, which proxies the bridge). Override
# only if you run the bridge on a different host or port.
# KOKORO_BASE_URL="http://localhost:8888"

# F5-TTS runs as a sibling local service (or remote endpoint, if you wrap one).
# When unset, the f5 provider defaults to http://localhost:8000 (VRM AI bridge
# host). Override to point at a dedicated F5 server.
# F5_BASE_URL="http://localhost:8000"

# --- Aura's brain (agent.dialogue + agent.banter Google AI / Gemini) ---------
# When set, `agent.dialogue` and `agent.banter` call Gemini with the active
# character bible + conversational memory. Without it, both capabilities return
# a graceful "(Aura's brain is offline — set GOOGLE_AI_API_KEY...)" fallback
# and the cast stays mute (UI surfaces remain renderable; nothing crashes).
# Get a key at https://aistudio.google.com/app/apikey (free tier suffices for
# development). Models default to gemini-2.5-flash (current stable, low-latency,
# JSON-structured-output compatible). Bump to gemini-2.5-pro for higher
# fidelity at higher cost.
# GOOGLE_AI_API_KEY=""
# GOOGLE_AI_MODEL="gemini-2.5-flash"

# --- SHARP service (commerce.sharp-job) --------------------------------------
# The studio's premium 2D-to-3D path. SHARP (Apple's single-image gaussian
# splatter) runs on the studio's local 3080 Ti machine, wrapped by the
# FastAPI service at python-services/sharp_service.py. When unset, the
# capability defaults to http://localhost:7842; production builds that
# cannot reach the studio fall back to the free in-browser depth-estimation
# path (viz.depth-estimation, lower quality). See docs/LOCAL_SERVICES.md.
# SHARP_SERVICE_URL="http://localhost:7842"

# --- SHARP-video service (commerce.sharp-video-job) --------------------------
# The studio's premium 2D-video-to-4D path. Per-keyframe SHARP + 4DGaussians
# temporal fit + stereo-MP4 stitch, wrapped by the FastAPI service at
# python-services/sharp_video_service.py on port 7843 (one above the photo
# service). When unset the capability defaults to http://localhost:7843;
# production builds that cannot reach the studio fall back to the free
# in-browser per-frame depth path. See docs/LOCAL_SERVICES.md.
# SHARP_VIDEO_SERVICE_URL="http://localhost:7843"

# --- Mesh service (InstantMesh — commercial-safe print-bar path) ------------
# The Apache-2.0-licensed alternative to SHARP. Wraps TencentARC/InstantMesh
# via the FastAPI service at python-services/mesh_service.py on port 7844.
# Single-image-to-GLB textured mesh on the studio's 3080 Ti. Default
# http://localhost:7844. Used by the print-bar's "commission this print"
# flow (SHARP's apple-amlr licence is research-only and unsafe for commercial
# use). See python-services/MESH_SERVICE.md.
# MESH_SERVICE_URL="http://localhost:7844"

# --- Shell 9 London map (MapLibre tile source) -------------------------------
# Public tile URL for the condensed-London caricature. Falls back to the
# open OpenStreetMap raster tiles if unset (rate-limited; not for
# production).
# NEXT_PUBLIC_MAPLIBRE_TILES_URL="https://tiles.holoflow.co.uk/{z}/{x}/{y}.png"

# --- Firebase (auth + Firestore) --------------------------------------------
# All NEXT_PUBLIC_FIREBASE_* keys are exposed to the browser bundle. That's
# fine — Firebase web config is intentionally public. Security comes from
# Firestore Rules (see firestore.rules), not key secrecy.
#
# Get the values from: Firebase Console → Project Settings → Your apps →
# Web app config object.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# --- Vercel Blob (operator media uploads) ------------------------------------
# Enable Blob storage in Vercel Project Settings → Storage; the Vercel CLI
# auto-injects this token into preview/production deployments. For local dev:
# `vercel env pull .env.local` after enabling the store, then this var lands
# in .env.local automatically.
# BLOB_READ_WRITE_TOKEN=""

# --- Firebase Admin SDK (server-side Firestore writes) -----------------------
# Required for the operator admin route (/admin/*) — server code uses this to
# verify ID tokens and to write `media` records through the admin SDK.
# Paste the JSON-stringified service-account key from Firebase Console →
# Project Settings → Service accounts → "Generate new private key". Store the
# whole JSON object as a single-line string (escape newlines in private_key as
# \n, which `lib/firebase/admin.ts` un-escapes at load time).
# FIREBASE_ADMIN_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Sanity CMS (optional — operator authoring of media + content)
# Create a project at https://sanity.io/manage; copy the projectId + dataset name here.
# NEXT_PUBLIC_SANITY_PROJECT_ID=""
# NEXT_PUBLIC_SANITY_DATASET="production"
# Read token (CORS-allowed origin includes holoflow.co.uk): Settings → API → Tokens → "Add API token" with Viewer perms.
# SANITY_API_READ_TOKEN=""
# Webhook revalidation secret — set this in Sanity → API → Webhooks (a webhook on every publish that POSTs to /api/sanity/revalidate?secret=THIS_VALUE)
# SANITY_REVALIDATE_SECRET=""

# --- Google OAuth (Photos Picker + Drive importers in /admin/import/*) ------
# Create at https://console.cloud.google.com/apis/credentials — "Web
# application" type. Enable on the project:
#   - Google Photos Picker API
#   - Google Drive API
#
# Authorised redirect URIs (add both):
#   https://holoflow.co.uk/api/admin/import/google/callback
#   http://localhost:3000/api/admin/import/google/callback
#
# Scopes requested at runtime (read-only):
#   - https://www.googleapis.com/auth/photospicker.mediaitems.readonly
#   - https://www.googleapis.com/auth/drive.readonly
#
# Note: the legacy Google Photos Library API broad-read scopes were
# deprecated on 31 March 2025; the import flow uses the Picker API instead
# (operator picks items in Google's modal; the studio sees only what is
# explicitly selected).
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional explicit override; otherwise derived from the request origin:
# GOOGLE_OAUTH_REDIRECT_URI="https://holoflow.co.uk/api/admin/import/google/callback"
