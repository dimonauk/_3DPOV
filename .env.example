# =============================================================================
# Holo-Flow Studio — environment variables
#
# Copy to .env.local for dev. Set the same keys in Vercel Project Settings
# for production. Never commit .env.local.
# =============================================================================

# --- Site identity -----------------------------------------------------------
SITE_NAME="Holo-Flow Studio"
COMPANY_NAME="Holo-Flow Studio"

# --- Shopify Storefront (required for anything to render) --------------------
# Staging (Shopify Partners dev store)
SHOPIFY_STORE_DOMAIN="holoflow-dev.myshopify.com"
# Production (swap at cutover):
# SHOPIFY_STORE_DOMAIN="holoflow.myshopify.com"

# Install the Headless app in Shopify admin, create a storefront, copy the
# Storefront API access token. Keep it read-only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Random shared secret. Generate with: openssl rand -hex 32
# Shopify webhooks include this as a query parameter when pinging
# /api/revalidate; the route rejects drive-by requests missing this.
SHOPIFY_REVALIDATION_SECRET=""

# --- 3D models (optional) ----------------------------------------------------
# Base URL for product GLB files. If unset, files resolve to
# /models/{product-handle}.glb served from public/models/. Point this at a
# CDN (e.g. Vercel Blob, Cloudflare R2) in production.
# NEXT_PUBLIC_MODEL_BASE_URL="https://cdn.holoflow.co.uk"

# --- Analytics (optional, no-ops until set) ---------------------------------
# Plausible: privacy-first, no cookie banner. Set to your canonical domain.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="holoflow.co.uk"

# Klaviyo: on-site tracking + embed script for signup forms / popups.
# Find your Company ID in Klaviyo → Account → Settings → API Keys.
# NEXT_PUBLIC_KLAVIYO_COMPANY_ID=""

# --- Transactional email (optional) -----------------------------------------
# When set, the /api/newsletter and /api/contact routes can forward to
# Klaviyo / Resend (today they just log to console).
# RESEND_API_KEY=""
# CONTACT_INBOX_EMAIL="contact@holoflow.co.uk"

# --- Firebase (auth + Firestore) --------------------------------------------
# All NEXT_PUBLIC_FIREBASE_* keys are exposed to the browser bundle. That's
# fine — Firebase web config is intentionally public. Security comes from
# Firestore Rules (see firestore.rules), not key secrecy.
#
# Get the values from: Firebase Console → Project Settings → Your apps →
# Web app config object.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
