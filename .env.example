# =============================================================================
# Holo-Flow Studio — environment variables
#
# Copy to .env.local for dev. Set the same keys in Vercel Project Settings
# for production. Never commit .env.local.
# =============================================================================

# --- Site identity -----------------------------------------------------------
SITE_NAME="Holo-Flow Studio"
COMPANY_NAME="Holo-Flow Studio"

# --- Shopify Storefront (required for anything to render) --------------------
# Staging (Shopify Partners dev store)
SHOPIFY_STORE_DOMAIN="holoflow-dev.myshopify.com"
# Production (swap at cutover):
# SHOPIFY_STORE_DOMAIN="holoflow.myshopify.com"

# Install the Headless app in Shopify admin, create a storefront, copy the
# Storefront API access token. Keep it read-only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Random shared secret. Generate with: openssl rand -hex 32
# Shopify webhooks include this as a query parameter when pinging
# /api/revalidate; the route rejects drive-by requests missing this.
SHOPIFY_REVALIDATION_SECRET=""

# --- 3D models (optional) ----------------------------------------------------
# Base URL for product GLB files. If unset, files resolve to
# /models/{product-handle}.glb served from public/models/. Point this at a
# CDN (e.g. Vercel Blob, Cloudflare R2) in production.
# NEXT_PUBLIC_MODEL_BASE_URL="https://cdn.holoflow.co.uk"

# --- Analytics (optional, no-ops until set) ---------------------------------
# Plausible: privacy-first, no cookie banner. Set to your canonical domain.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="holoflow.co.uk"

# Klaviyo: on-site tracking + embed script for signup forms / popups.
# Find your Company ID in Klaviyo → Account → Settings → API Keys.
# NEXT_PUBLIC_KLAVIYO_COMPANY_ID=""

# --- Transactional email (optional) -----------------------------------------
# When set, the /api/newsletter and /api/contact routes can forward to
# Klaviyo / Resend (today they just log to console).
# RESEND_API_KEY=""
# CONTACT_INBOX_EMAIL="contact@holoflow.co.uk"

# --- Aura's voice (audio.tts ElevenLabs provider) ----------------------------
# When set, `audio.tts` can route to the "elevenlabs" provider for
# studio-quality voice. Without it, audio.tts falls back to the browser's
# Web Speech API (always available, no API key, lower fidelity).
# Sign up at https://elevenlabs.io/. The free tier suffices for development.
# ELEVENLABS_API_KEY=""
# ELEVENLABS_DEFAULT_VOICE_ID=""

# --- Aura's voice (audio.tts local providers) --------------------------------
# Kokoro is the local TTS service surfaced by the Hangar's VRM AI bridge
# (`docs/LOCAL_SERVICES.md`). When unset, the kokoro provider defaults to
# http://localhost:8888 (Aura-Alive HTTP, which proxies the bridge). Override
# only if you run the bridge on a different host or port.
# KOKORO_BASE_URL="http://localhost:8888"

# F5-TTS runs as a sibling local service (or remote endpoint, if you wrap one).
# When unset, the f5 provider defaults to http://localhost:8000 (VRM AI bridge
# host). Override to point at a dedicated F5 server.
# F5_BASE_URL="http://localhost:8000"

# --- Aura's brain (agent.dialogue + agent.banter Google AI / Gemini) ---------
# When set, `agent.dialogue` and `agent.banter` call Gemini with the active
# character bible + conversational memory. Without it, both capabilities return
# a graceful "(Aura's brain is offline — set GOOGLE_AI_API_KEY...)" fallback
# and the cast stays mute (UI surfaces remain renderable; nothing crashes).
# Get a key at https://aistudio.google.com/app/apikey (free tier suffices for
# development). Models default to gemini-2.5-flash (current stable, low-latency,
# JSON-structured-output compatible). Bump to gemini-2.5-pro for higher
# fidelity at higher cost.
# GOOGLE_AI_API_KEY=""
# GOOGLE_AI_MODEL="gemini-2.5-flash"

# --- SHARP service (commerce.sharp-job) --------------------------------------
# The studio's premium 2D-to-3D path. SHARP (Apple's single-image gaussian
# splatter) runs on the studio's local 3080 Ti machine, wrapped by the
# FastAPI service at python-services/sharp_service.py. When unset, the
# capability defaults to http://localhost:7842; production builds that
# cannot reach the studio fall back to the free in-browser depth-estimation
# path (viz.depth-estimation, lower quality). See docs/LOCAL_SERVICES.md.
# SHARP_SERVICE_URL="http://localhost:7842"

# --- SHARP-video service (commerce.sharp-video-job) --------------------------
# The studio's premium 2D-video-to-4D path. Per-keyframe SHARP + 4DGaussians
# temporal fit + stereo-MP4 stitch, wrapped by the FastAPI service at
# python-services/sharp_video_service.py on port 7843 (one above the photo
# service). When unset the capability defaults to http://localhost:7843;
# production builds that cannot reach the studio fall back to the free
# in-browser per-frame depth path. See docs/LOCAL_SERVICES.md.
# SHARP_VIDEO_SERVICE_URL="http://localhost:7843"

# --- Mesh service (InstantMesh — commercial-safe print-bar path) ------------
# The Apache-2.0-licensed alternative to SHARP. Wraps TencentARC/InstantMesh
# via the FastAPI service at python-services/mesh_service.py on port 7844.
# Single-image-to-GLB textured mesh on the studio's 3080 Ti. Default
# http://localhost:7844. Used by the print-bar's "commission this print"
# flow (SHARP's apple-amlr licence is research-only and unsafe for commercial
# use). See python-services/MESH_SERVICE.md.
# MESH_SERVICE_URL="http://localhost:7844"

# --- AR card analytics — IP hashing (REQUIRED IN PROD) ----------------------
# Salt mixed into SHA-256 IP hashes for AR card view/lead analytics so we can
# rate-limit and dedupe without storing raw IPs. lib/cards/ip-hash.ts throws
# at request time when NODE_ENV=production and this is unset — the deploy
# fails fast rather than silently using a predictable salt. In dev it falls
# back to "holoflow-dev-only-do-not-ship".
# Generate with: openssl rand -hex 32
# IP_HASH_SALT=""

# --- Shell 9 London map (MapLibre tile source) -------------------------------
# Public tile URL for the condensed-London caricature. Falls back to the
# open OpenStreetMap raster tiles if unset (rate-limited; not for
# production).
# NEXT_PUBLIC_MAPLIBRE_TILES_URL="https://tiles.holoflow.co.uk/{z}/{x}/{y}.png"

# --- Firebase (auth + Firestore) --------------------------------------------
# All NEXT_PUBLIC_FIREBASE_* keys are exposed to the browser bundle. That's
# fine — Firebase web config is intentionally public. Security comes from
# Firestore Rules (see firestore.rules), not key secrecy.
#
# Get the values from: Firebase Console → Project Settings → Your apps →
# Web app config object.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# --- Vercel Blob (operator media uploads) ------------------------------------
# Enable Blob storage in Vercel Project Settings → Storage; the Vercel CLI
# auto-injects this token into preview/production deployments. For local dev:
# `vercel env pull .env.local` after enabling the store, then this var lands
# in .env.local automatically.
# BLOB_READ_WRITE_TOKEN=""

# --- Firebase Admin SDK (server-side Firestore writes) -----------------------
# Required for the operator admin route (/admin/*) — server code uses this to
# verify ID tokens and to write `media` records through the admin SDK.
# Paste the JSON-stringified service-account key from Firebase Console →
# Project Settings → Service accounts → "Generate new private key". Store the
# whole JSON object as a single-line string (escape newlines in private_key as
# \n, which `lib/firebase/admin.ts` un-escapes at load time).
# FIREBASE_ADMIN_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Sanity CMS (optional — operator authoring of media + content)
# Create a project at https://sanity.io/manage; copy the projectId + dataset name here.
# NEXT_PUBLIC_SANITY_PROJECT_ID=""
# NEXT_PUBLIC_SANITY_DATASET="production"
# Read token (CORS-allowed origin includes holoflow.co.uk): Settings → API → Tokens → "Add API token" with Viewer perms.
# SANITY_API_READ_TOKEN=""
# Webhook revalidation secret — set this in Sanity → API → Webhooks (a webhook on every publish that POSTs to /api/sanity/revalidate?secret=THIS_VALUE)
# SANITY_REVALIDATE_SECRET=""

# --- Google OAuth (Photos Picker + Drive importers in /admin/import/*) ------
# Create at https://console.cloud.google.com/apis/credentials — "Web
# application" type. Enable on the project:
#   - Google Photos Picker API
#   - Google Drive API
#
# Authorised redirect URIs (add both):
#   https://holoflow.co.uk/api/admin/import/google/callback
#   http://localhost:3000/api/admin/import/google/callback
#
# Scopes requested at runtime (read-only):
#   - https://www.googleapis.com/auth/photospicker.mediaitems.readonly
#   - https://www.googleapis.com/auth/drive.readonly
#
# Note: the legacy Google Photos Library API broad-read scopes were
# deprecated on 31 March 2025; the import flow uses the Picker API instead
# (operator picks items in Google's modal; the studio sees only what is
# explicitly selected).
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional explicit override; otherwise derived from the request origin:
# GOOGLE_OAUTH_REDIRECT_URI="https://holoflow.co.uk/api/admin/import/google/callback"

# Optional client-side API key for Drive Picker preview thumbnails (NOT a
# secret — restrict by HTTP referrer in the Cloud Console). Falls back to
# unauthenticated fetches when absent (lower thumbnail success rate).
# NEXT_PUBLIC_DRIVE_API_KEY=""

# =============================================================================
# Shopify — webhook signature & metaobject handles
# =============================================================================

# HMAC secret for the canonical Shopify webhook signing path. Copy from
# Shopify admin → Notifications → Webhooks → "Reveal webhook signature".
# /api/revalidate verifies X-Shopify-Hmac-Sha256 against this; the legacy
# URL-query secret (SHOPIFY_REVALIDATION_SECRET above) remains accepted
# as a transitional fallback. Required for webhooks created post-2024.
# SHOPIFY_WEBHOOK_HMAC_SECRET=""

# Metaobject handle used by lib/print-vendors/shopify-source.ts to resolve
# the print-vendor catalogue. Defaults inside the code; only override if
# the metaobject is renamed.
# SHOPIFY_VENDOR_METAOBJECT_HANDLE=""

# =============================================================================
# Apple Wallet (.pkpass) — passkit-generator
# =============================================================================
# All five PEM/identifier vars are required to enable the Wallet pass
# routes (/api/cards/[slug]/wallet/apple). When ANY are missing, the
# capability returns "wallet not configured" and the UI hides the button.
# Cert/key acquisition: Apple Developer → Certificates, Identifiers &
# Profiles → Pass Type IDs. Export as PEM, paste contents (NOT a path).
#
# APPLE_PASS_TYPE_ID="pass.co.uk.holoflow.card"
# APPLE_TEAM_ID=""
# APPLE_PASS_CERT_PEM=""        # full PEM string, BEGIN CERTIFICATE ... END
# APPLE_PASS_KEY_PEM=""         # full PEM string, BEGIN PRIVATE KEY ... END
# APPLE_WWDR_CERT_PEM=""        # Apple WWDR intermediate, PEM
# APPLE_PASS_KEY_PASSPHRASE=""  # only if the private key is encrypted
# APPLE_PASS_WEB_SERVICE_URL="" # optional — for push pass updates

# =============================================================================
# Google Wallet — google-wallet.ts
# =============================================================================
# All four vars required to enable Google Wallet add-to-wallet URLs.
# Service-account JSON download from Google Cloud → IAM → Service accounts.
# The private key is the PEM-formatted "private_key" field from that JSON
# (preserve the literal \n escapes — the code un-escapes at load time).
#
# GOOGLE_WALLET_ISSUER_ID=""
# GOOGLE_WALLET_CLASS_ID=""
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=""

# =============================================================================
# Vercel AI Gateway — card scanner, enrich, aura-server
# =============================================================================
# Single key fronting multiple AI providers via Vercel's gateway. Model
# names use "provider/model" strings (e.g. "anthropic/claude-haiku-4-5",
# "openai/gpt-4o-mini"). Get the key from Vercel dashboard → Storage →
# AI Gateway. Without it, the card scanner falls back to a text-only
# enrichment path and Aura's server-side replies stop.
#
# AI_GATEWAY_API_KEY=""
# AI_GATEWAY_MODEL_TEXT="anthropic/claude-haiku-4-5"
# AI_GATEWAY_MODEL_VISION="anthropic/claude-haiku-4-5"

# =============================================================================
# Image-to-3D + Text-to-3D services (lib/capabilities/viz/*)
# =============================================================================
# Self-hosted wrappers around TripoSR (image → mesh) and TRELLIS
# (text → mesh). Both default to the studio's local bench when unset;
# production builds that can't reach the bench surface a "service
# unavailable" error to the caller. Tokens optional — protect the
# endpoints with a shared bearer if they're internet-reachable.
#
# TRIPOSR_SERVICE_URL="http://localhost:7845"
# TRIPOSR_AUTH_TOKEN=""
# TRELLIS_SERVICE_URL="http://localhost:7846"
# TRELLIS_AUTH_TOKEN=""

# =============================================================================
# Email — rookery onboarding + card leads
# =============================================================================
# Two email surfaces; both default to "console" provider (logs only).
#
# Rookery onboarding (welcome emails to new creator subscribers):
# EMAIL_PROVIDER="resend"         # "resend" | "console" (default)
# EMAIL_FROM="hello@holoflow.co.uk"
# EMAIL_REPLY_TO="hello@holoflow.co.uk"
#
# Card lead capture (from-address for /api/cards/[slug]/lead replies):
# RESEND_FROM_ADDRESS="hello@holoflow.co.uk"
#
# Order/contact notifications (Shopify order receipts, etc.):
# ORDER_FROM_EMAIL="orders@holoflow.co.uk"

# =============================================================================
# Public base URLs — used by build-time scripts + Wallet routes
# =============================================================================
# Canonical public URL for the deployment. Used by scripts/ar-generate-qr.mjs
# when generating QR codes for AR cards, and by wallet route handlers when
# building absolute pass URLs.
# PUBLIC_BASE_URL="https://holoflow.co.uk"

# Host-only variant for vCard (cards/[slug]/vcard) — without scheme.
# PUBLIC_DOMAIN="holoflow.co.uk"

# =============================================================================
# Vercel Blob — private partition
# =============================================================================
# Second Blob store with private access (operator-only media that should
# never be publicly fetchable). Generated alongside BLOB_READ_WRITE_TOKEN
# by `vercel env pull` once a second store is provisioned in the dashboard.
# PRIVATE_BLOB_READ_WRITE_TOKEN=""

# =============================================================================
# Firebase Admin — alternative credential sources
# =============================================================================
# lib/firebase/admin.ts tries these in order before falling back to
# FIREBASE_ADMIN_SERVICE_ACCOUNT. Useful when running on GCP/Cloud Run
# (auto-injected) or when the service-account JSON lives on disk:
#
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/sa.json"
# FIREBASE_ADMIN_PROJECT_ID=""      # falls back to GCP_PROJECT / GCLOUD_PROJECT

# Firebase App Check — optional. The recaptcha site key wires the v3
# reCAPTCHA provider; the debug token suppresses enforcement in dev when
# running outside an attested browser.
# NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=""
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# =============================================================================
# Operator allow-list
# =============================================================================
# Comma-separated emails authorised for /admin/* + /api/admin/*.
#
# Defaults to dimonauk@gmail.com when both vars are unset — preserves the
# single-operator launch posture. Set ADMIN_EMAILS to a comma list to add
# operators without a code deploy.
#
# Server routes read ADMIN_EMAILS. The /admin layout is a client
# component and can only see vars Next inlines into the browser bundle
# (NEXT_PUBLIC_*); set NEXT_PUBLIC_ADMIN_EMAILS to the SAME list so the
# client-side UI gate stays in sync with the server enforcement.
#
# The email list is not a secret — Firestore Rules + per-route bearer
# verification are the actual gates. NEXT_PUBLIC_ADMIN_EMAILS shipping
# in the browser bundle is by design.
#
# ADMIN_EMAILS="alice@holoflow.co.uk,bob@holoflow.co.uk"
# NEXT_PUBLIC_ADMIN_EMAILS="alice@holoflow.co.uk,bob@holoflow.co.uk"

# =============================================================================
# Rate-limit storage — Upstash Redis (recommended for prod)
# =============================================================================
# When set, lib/rate-limit/fixed-window switches the rate-limit counters
# for /api/cards/scan, /api/print-check, /api/log, and
# /api/ai/google/generate-image (studio quota path) from a per-isolate
# in-memory Map to Upstash Redis — so the cap holds across Fluid Compute
# isolates / scale-outs. Without these vars the in-memory fallback
# preserves the historic best-effort behaviour.
#
# Provision via the Vercel Marketplace (Storage → Upstash Redis); the
# CLI auto-injects both vars into preview/production. For local dev:
# `vercel env pull .env.local` after provisioning.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# =============================================================================
# AR card compile — subprocess fallback (opt-in)
# =============================================================================
# When set to "1", lib/capabilities/ar/compile-target.server.ts will spawn
# scripts/ar-compile-mind-from-bytes.mjs as a fresh node subprocess if the
# in-process mind-ar compile throws (TF.js / sharp / mind-ar module-state
# corruption inside the long-lived Next.js server). The subprocess runs
# identical compile logic in isolation — useful on bench / dev boxes where
# spawning is permitted. Defaults off in production (Vercel functions
# can't reliably exec node scripts at runtime).
# AR_COMPILE_FALLBACK_ENABLED="1"

# =============================================================================
# Vercel Cron — shared secret
# =============================================================================
# Cron-triggered routes (currently: /api/cron/rookery-pending-emails)
# verify Authorization: Bearer ${CRON_SECRET} on every invocation.
# Vercel injects this header automatically when CRON_SECRET is set in
# the project. Without it the route refuses with 503 — better than
# being a public mailer.
#
# Generate a fresh value:
#   openssl rand -hex 32
#
# Then set in Vercel Project Settings → Environment Variables (Production
# + Preview as needed) AND in .env.local for local cron-handler tests.
# CRON_SECRET=""

# =============================================================================
# Email — dedicated unsubscribe address (optional)
# =============================================================================
# The mailer emits RFC-2369 List-Unsubscribe + RFC-8058
# List-Unsubscribe-Post=One-Click headers on every Rookery send. The
# mailto: target defaults to EMAIL_REPLY_TO (so honest "stop" replies
# land in the same inbox the operator already reads); set this when a
# dedicated unsub mailbox is wired.
# EMAIL_UNSUBSCRIBE_ADDRESS="unsubscribe@holoflow.co.uk"

# =============================================================================
# Printfiles engine — customer STL/GLB intake at printfiles@holoflow.co.uk
# =============================================================================
# Inbound transport — v1 uses Resend Inbound. The secret is the one
# shown when you create the inbound webhook on resend.com/inbound.
# RESEND_INBOUND_WEBHOOK_SECRET=""
#
# Dev escape hatch — accepts unsigned POSTs at /api/printfiles/intake
# for local curl testing. NEVER set to "1" in production.
# RESEND_INBOUND_SKIP_SIGNATURE=""
#
# Where the gracious reply comes from + where the manual-provider
# forwarder sends the operator packet. Default values shown.
# PRINTFILES_INBOX_EMAIL="printfiles@holoflow.co.uk"
# PRINTFILES_OPERATOR_EMAIL="dimona@holoflow.co.uk"
#
# Per-attachment + total payload size caps in MB. Defaults: 20 / 50.
# Higher values risk Resend Inbound's 40 MB total-payload cap; the
# rejection reply directs senders to email a Drive/Dropbox link
# instead when they hit the cap.
# PRINTFILES_MAX_ATTACHMENT_MB="20"
# PRINTFILES_MAX_TOTAL_MB="50"
#
# When the customer sends a Drive / Dropbox / OneDrive link instead
# of an attachment (because Resend Inbound caps at ~25 MB total
# payload), the listener fetches from the link. This cap is the
# upper bound for the downloaded file. Default 100 MB — large enough
# for most real STLs / GLBs, small enough that a malicious link to
# a 5 GB file can't OOM the function.
# PRINTFILES_MAX_LINK_MB="100"
#
# Which print farm the engine forwards to. v1 ships only the
# "manual" provider (operator handles the forward themselves via the
# packet email the engine sends). Future: treatstock, slant3d,
# craftcloud.
# PRINTFARM_PROVIDER="manual"
#
# Provider-specific creds (only when PRINTFARM_PROVIDER is set to
# one of these):
# TREATSTOCK_API_KEY=""
# SLANT3D_API_KEY=""

# =============================================================================
# Logging
# =============================================================================
# Threshold for lib/log.ts. Honoured server-side and on the client (the
# /api/log forwarder respects it too). Levels: "trace" | "debug" | "info"
# | "warn" | "error" | "fatal" | "silent". Defaults to "info" in
# production, "debug" otherwise.
# LOG_LEVEL="info"

# =============================================================================
# Outstanding-wiring env vars — placeholders for capabilities awaiting
# operator-side setup. See docs/EXTERNAL_DEPS_QUEUE.md for what each
# capability needs before it goes from registered-but-stubbed to live.
# =============================================================================

# --- Tracking — Azure Kinect bridge (lib/tracking/sources/kinect-bridge.ts) -
# The Kinect SDK is Windows-native and can't run in a browser. The studio's
# bench machine wraps it in a small FastAPI that publishes head + eye
# positions over Server-Sent Events; this client connects to it over
# Tailscale (Funnel for cross-network use, magic-DNS-only for in-tailnet
# rigs). See docs/TRACKING.md for the endpoint contract.
#
# Both vars are NEXT_PUBLIC_ because the client opens the EventSource
# directly from the browser bundle. The bearer is a shared secret, not a
# user secret — protects the bridge from drive-by scrapers, doesn't
# authenticate individual users.
#
# NEXT_PUBLIC_KINECT_BRIDGE_URL="https://kinect.tail99b2a4.ts.net"
# NEXT_PUBLIC_KINECT_BRIDGE_TOKEN=""

# --- ComfyUI (viz.generate-comfyui) ----------------------------------------
# Tailscale Funnel URL for the bench ComfyUI instance (D:/The_Hangar/engines/
# comfyui/, port 8188). When unset, the capability throws
# service-unavailable; surfaces fall back to placeholder thumbnails.
# COMFYUI_SERVICE_URL="https://comfyui.tail99b2a4.ts.net"
# COMFYUI_AUTH_TOKEN=""

# --- splat360 (viz.splat-generate-360) -------------------------------------
# Bench splat360 service at D:/The_Hangar/engines/splat360/ (port 8390).
# Reached over Tailscale; same auth pattern as ComfyUI.
# SPLAT360_SERVICE_URL="https://splat360.tail99b2a4.ts.net"
# SPLAT360_AUTH_TOKEN=""

# --- Ollama (agent.dialogue-ollama) ---------------------------------------
# Hangar bench Ollama server. Models: llama3.1:8b, qwen2.5:7b, etc.
# OLLAMA_SERVICE_URL="https://ollama.tail99b2a4.ts.net"
# OLLAMA_AUTH_TOKEN=""
# OLLAMA_DEFAULT_MODEL="llama3.1:8b"

# --- Stripe (shared across subscription gates + print bureau) -------------
# Two use cases share the same Stripe account + keys:
#
#   1. Rookery subscription gates (PERCH/NEST/FLEDGE tiers)
#      Wiring guide: docs/STRIPE_GATING.md
#      Uses STRIPE_PRICE_* + NEXT_PUBLIC_BILLING_PORTAL_RETURN_URL
#
#   2. Print bureau orders (per-order Payment Intents)
#      Plan: docs/BUREAU-AR-LOOP-PLAN.md
#      Pipeline: lib/bureau/order.ts + lib/stripe/server.ts +
#                /api/bureau/order + /api/stripe/webhook
#      No PRICE_* env vars (prices computed from lib/bureau/pricing.ts;
#      each order creates a fresh Payment Intent with the priced amount).
#
# Until STRIPE_SECRET_KEY is set, both surfaces return 503
# `stripe_not_configured` / `service-unavailable` cleanly — no build
# break, the picker UI surfaces the message.
#
# To enable the bureau end-to-end after slotting these in:
#   pnpm add @stripe/stripe-js @stripe/react-stripe-js
# Then wire Stripe Elements in app/bureau/checkout/[orderId]/page.tsx
# (currently a scaffold placeholder — see file header).
#
# STRIPE_SECRET_KEY=""                                  # sk_test_... or sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""                 # pk_test_... or pk_live_...
# STRIPE_WEBHOOK_SECRET=""                              # whsec_... (Stripe dashboard → Developers → Webhooks → your endpoint)
# STRIPE_PRICE_PERCH=""                                 # subscription tier only
# STRIPE_PRICE_NEST=""                                  # subscription tier only
# STRIPE_PRICE_FLEDGE=""                                # subscription tier only
# NEXT_PUBLIC_BILLING_PORTAL_RETURN_URL=""              # subscription tier only

# --- Vercel Cron (Rookery delayed emails) ---------------------------------
# vercel.json should declare cron jobs for Day-3 / Day-7 onboarding sends.
# Once wired, this signs requests so the route can verify the call came
# from Vercel's cron runner. Generate with: openssl rand -hex 32
# CRON_SECRET=""
