# =============================================================================
# Holo-Flow Studio — environment variables
#
# Copy to .env.local for dev. Set the same keys in Vercel Project Settings
# for production. Never commit .env.local.
# =============================================================================

# --- Site identity -----------------------------------------------------------
SITE_NAME="Holo-Flow Studio"
COMPANY_NAME="Holo-Flow Studio"

# --- Shopify Storefront (required for anything to render) --------------------
# Staging (Shopify Partners dev store)
SHOPIFY_STORE_DOMAIN="holoflow-dev.myshopify.com"
# Production (swap at cutover):
# SHOPIFY_STORE_DOMAIN="holoflow.myshopify.com"

# Install the Headless app in Shopify admin, create a storefront, copy the
# Storefront API access token. Keep it read-only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Random shared secret. Generate with: openssl rand -hex 32
# Shopify webhooks include this as a query parameter when pinging
# /api/revalidate; the route rejects drive-by requests missing this.
SHOPIFY_REVALIDATION_SECRET=""

# --- 3D models (optional) ----------------------------------------------------
# Base URL for product GLB files. If unset, files resolve to
# /models/{product-handle}.glb served from public/models/. Point this at a
# CDN (e.g. Vercel Blob, Cloudflare R2) in production.
# NEXT_PUBLIC_MODEL_BASE_URL="https://cdn.holoflow.co.uk"
