# =============================================================================
# Holo-Flow Studio — environment variables
#
# Copy to .env.local for dev. Set the same keys in Vercel Project Settings
# for production. Never commit .env.local.
# =============================================================================

# --- Site identity -----------------------------------------------------------
SITE_NAME="Holo-Flow Studio"
COMPANY_NAME="Holo-Flow Studio"

# --- Shopify Storefront (required for anything to render) --------------------
# Staging (Shopify Partners dev store)
SHOPIFY_STORE_DOMAIN="holoflow-dev.myshopify.com"
# Production (swap at cutover):
# SHOPIFY_STORE_DOMAIN="holoflow.myshopify.com"

# Install the Headless app in Shopify admin, create a storefront, copy the
# Storefront API access token. Keep it read-only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Random shared secret. Generate with: openssl rand -hex 32
# Shopify webhooks include this as a query parameter when pinging
# /api/revalidate; the route rejects drive-by requests missing this.
SHOPIFY_REVALIDATION_SECRET=""

# --- 3D models (optional) ----------------------------------------------------
# Base URL for product GLB files. If unset, files resolve to
# /models/{product-handle}.glb served from public/models/. Point this at a
# CDN (e.g. Vercel Blob, Cloudflare R2) in production.
# NEXT_PUBLIC_MODEL_BASE_URL="https://cdn.holoflow.co.uk"

# --- Analytics (optional, no-ops until set) ---------------------------------
# Plausible: privacy-first, no cookie banner. Set to your canonical domain.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="holoflow.co.uk"

# Klaviyo: on-site tracking + embed script for signup forms / popups.
# Find your Company ID in Klaviyo → Account → Settings → API Keys.
# NEXT_PUBLIC_KLAVIYO_COMPANY_ID=""

# --- Transactional email (optional) -----------------------------------------
# When set, the /api/newsletter and /api/contact routes can forward to
# Klaviyo / Resend (today they just log to console).
# RESEND_API_KEY=""
# CONTACT_INBOX_EMAIL="contact@holoflow.co.uk"

# --- Aura's voice (audio.tts ElevenLabs provider) ----------------------------
# When set, `audio.tts` can route to the "elevenlabs" provider for
# studio-quality voice. Without it, audio.tts falls back to the browser's
# Web Speech API (always available, no API key, lower fidelity).
# Sign up at https://elevenlabs.io/. The free tier suffices for development.
# ELEVENLABS_API_KEY=""
# ELEVENLABS_DEFAULT_VOICE_ID=""

# --- Aura's voice (audio.tts local providers) --------------------------------
# Kokoro is the local TTS service surfaced by the Hangar's VRM AI bridge
# (`docs/LOCAL_SERVICES.md`). When unset, the kokoro provider defaults to
# http://localhost:8888 (Aura-Alive HTTP, which proxies the bridge). Override
# only if you run the bridge on a different host or port.
# KOKORO_BASE_URL="http://localhost:8888"

# F5-TTS runs as a sibling local service (or remote endpoint, if you wrap one).
# When unset, the f5 provider defaults to http://localhost:8000 (VRM AI bridge
# host). Override to point at a dedicated F5 server.
# F5_BASE_URL="http://localhost:8000"

# --- Aura's brain (agent.dialogue Google AI / Gemini) ------------------------
# When set, `agent.dialogue` calls Gemini with the active character bible +
# conversational memory. Without it, agent.dialogue throws "no provider
# configured" and the cast stays mute.
# Get a key at https://aistudio.google.com/app/apikey.
# GOOGLE_AI_API_KEY=""
# GOOGLE_AI_MODEL="gemini-2.0-flash-exp"

# --- SHARP service (commerce.sharp-job) --------------------------------------
# The studio's premium 2D-to-3D path. SHARP (Apple's single-image gaussian
# splatter) runs on the studio's local 3080 Ti machine, wrapped by the
# FastAPI service at python-services/sharp_service.py. When unset, the
# capability defaults to http://localhost:7842; production builds that
# cannot reach the studio fall back to the free in-browser depth-estimation
# path (viz.depth-estimation, lower quality). See docs/LOCAL_SERVICES.md.
# SHARP_SERVICE_URL="http://localhost:7842"

# --- Shell 9 London map (MapLibre tile source) -------------------------------
# Public tile URL for the condensed-London caricature. Falls back to the
# open OpenStreetMap raster tiles if unset (rate-limited; not for
# production).
# NEXT_PUBLIC_MAPLIBRE_TILES_URL="https://tiles.holoflow.co.uk/{z}/{x}/{y}.png"

# --- Firebase (auth + Firestore) --------------------------------------------
# All NEXT_PUBLIC_FIREBASE_* keys are exposed to the browser bundle. That's
# fine — Firebase web config is intentionally public. Security comes from
# Firestore Rules (see firestore.rules), not key secrecy.
#
# Get the values from: Firebase Console → Project Settings → Your apps →
# Web app config object.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
