rules_version = '2';

// Holo-Flow Studio — Firestore security rules.
//
// Deploy via Firebase Console (Firestore → Rules → paste → publish) or
// `firebase deploy --only firestore:rules` from a CLI that's logged in
// to the gen-lang-client-0149679024 project.

service cloud.firestore {
  match /databases/{database}/documents {

    // Newsletter subscribers — anyone can opt in by creating a single
    // record with a sensible shape. Reads / updates / deletes are
    // server-only (admin SDK or Firebase Console).
    match /subscribers/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 320
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.source is string
        && request.resource.data.source.size() < 64;
      allow read, update, delete: if false;
    }

    // User profiles — full magic-link account holders. Each user can
    // read / write only their own document.
    match /users/{userId} {
      allow read, update, create:
        if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // The Rookery — public read, signed-in write, no edits, no
    // deletes. What you put in the air, you put in the air.
    match /threads/{threadId} {
      allow read: if true;
      allow create: if
        request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.keys().hasOnly([
             'title', 'body', 'authorUid', 'authorName', 'createdAt'
           ]);
      allow update, delete: if false;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if
          request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000
          && request.resource.data.keys().hasOnly([
               'body', 'authorUid', 'authorName', 'createdAt'
             ]);
        allow update, delete: if false;
      }
    }

    // Operator media library — Vercel Blob URL + Firestore metadata.
    // Reads are public (the URL is the canonical reference; nothing
    // secret lives here) except for retired items, which the public
    // site hides. All writes go through the admin SDK from the
    // operator-only `/admin/*` route, which bypasses these rules.
    match /media/{id} {
      allow read: if !('retired' in resource.data) || resource.data.retired != true;
      allow write: if false;
    }

  }
}
