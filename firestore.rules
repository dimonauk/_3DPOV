rules_version = '2';

// Holo-Flow Studio — Firestore security rules.
//
// Deploy via Firebase Console (Firestore → Rules → paste → publish) or
// `firebase deploy --only firestore:rules` from a CLI that's logged in
// to the gen-lang-client-0149679024 project.

service cloud.firestore {
  match /databases/{database}/documents {

    // Newsletter subscribers — anyone can opt in by creating a single
    // record with a sensible shape. Reads / updates / deletes are
    // server-only (admin SDK or Firebase Console).
    match /subscribers/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 320
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.source is string
        && request.resource.data.source.size() < 64;
      allow read, update, delete: if false;
    }

    // User profiles — full magic-link account holders. Each user can
    // read / write only their own document.
    match /users/{userId} {
      allow read, update, create:
        if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // AR business cards — slug is the doc ID.
    //
    // Read: anyone (the card landing pages at /c/<slug> must render for
    //   unauthenticated visitors).
    // Create: signed-in users only, and the new doc must claim them as
    //   owner. Slug is the doc ID, so duplicate slugs naturally fail
    //   via create-only-when-missing semantics combined with the
    //   "only your own" rule on update.
    // Update: only the existing owner.
    // Delete: only the existing owner.
    //
    // Shape validation: must include the slug, the ownerUid (== caller),
    // the card payload, timestamps, and the flags. Card payload itself
    // is not deep-validated by rules; size cap (5KB serialised) is the
    // backstop. Studio-hosted cards (hosted: true) cannot be created or
    // modified from the client — only via the admin SDK with the
    // service-account credential.
    match /cards/{slug} {
      allow read: if true;

      allow create: if
        request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == slug
        && request.resource.data.card is map
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.public is bool
        && (
          !('hosted' in request.resource.data)
          || request.resource.data.hosted == false
        )
        && slug.matches('^[a-z0-9][a-z0-9-]{1,31}$');

      allow update: if
        request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == slug
        && (
          !('hosted' in request.resource.data)
          || request.resource.data.hosted == resource.data.hosted
        );

      allow delete: if
        request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Analytics events under each card. Anonymous visitor writes are
      // mediated by the admin SDK from /api/cards/[slug]/events, so the
      // client direct-write path is disabled here. Reads are restricted
      // to the card owner.
      match /events/{eventId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/cards/$(slug)).data.ownerUid == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Lead capture submissions. Same posture as events — admin SDK
      // writes only, owner-only reads.
      match /leads/{leadId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/cards/$(slug)).data.ownerUid == request.auth.uid;
        allow create, update, delete: if false;
      }
    }

    // The Rookery — public read, signed-in write, no edits, no
    // deletes. What you put in the air, you put in the air.
    match /threads/{threadId} {
      allow read: if true;
      allow create: if
        request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.keys().hasOnly([
             'title', 'body', 'authorUid', 'authorName', 'createdAt'
           ]);
      allow update, delete: if false;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if
          request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000
          && request.resource.data.keys().hasOnly([
               'body', 'authorUid', 'authorName', 'createdAt'
             ]);
        allow update, delete: if false;
      }
    }

    // Operator media library — Vercel Blob URL + Firestore metadata.
    // Reads are public (the URL is the canonical reference; nothing
    // secret lives here) except for retired items, which the public
    // site hides. All writes go through the admin SDK from the
    // operator-only `/admin/*` route, which bypasses these rules.
    match /media/{id} {
      allow read: if !('retired' in resource.data) || resource.data.retired != true;
      allow write: if false;
    }

    // Rookery nurture-email queue — Day 3 + Day 7 sends scheduled by
    // the onboarding route, swept daily by the cron at
    // /api/cron/rookery-pending-emails. Reads would expose member
    // email addresses (and the perch roster); writes would let a
    // visitor inject mail. Admin SDK only.
    match /pending_emails/{id} {
      allow read, write: if false;
    }

    // Printfile orders — customer STL/GLB intake from printfiles@
    // holoflow.co.uk. Reads would expose customer emails + their
    // private 3D files (which we drop-ship to a print farm). Writes
    // would let a visitor inject fake orders. Admin SDK only; the
    // /admin/printfiles dashboard reads via the server (server
    // component fetch) so it bypasses these rules.
    match /printfile_orders/{id} {
      allow read, write: if false;
    }

    // Bureau orders — fine-art print orders (size + paper + edition)
    // off the bureau picker UI. Customer email, Stripe Payment Intent
    // id, and shipping address all live here. Operator-only. The
    // /admin/bureau dashboard reads via server components, bypassing
    // these rules. Webhook + checkout-completion writes use the
    // admin SDK.
    match /bureau_orders/{id} {
      allow read, write: if false;

      // Audit log — append-only timeline of every meaningful side-effect
      // on the order. Source of truth for dispute defence (chargebacks,
      // refund claims) and the operator-dashboard timeline. Admin SDK
      // writes only, same as the parent doc.
      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // GDPR rights-of-the-data-subject requests — access / deletion /
    // rectification / portability / objection. Reads would expose
    // every customer who has invoked their UK-GDPR rights (extremely
    // sensitive). Writes go through the admin SDK from
    // /api/gdpr/request. Admin SDK only.
    match /gdpr_requests/{id} {
      allow read, write: if false;
    }

    // Rookery subscriptions — the local mirror of Stripe subscription
    // state, keyed by Firebase uid. Reads would expose member emails
    // + the perch roster; writes would let a visitor forge a
    // subscription and bypass the gate. Webhook writes via admin SDK;
    // server-component reads via admin SDK. Client-side reads + writes
    // are denied entirely.
    match /rookery_subscriptions/{uid} {
      allow read, write: if false;
    }

  }
}
