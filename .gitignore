# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*

# CCTV pipeline runtime artifacts (kept local only — dignity-of-capture
# rules + bandwidth + repo bloat). Generated by:
#   scripts/cctv-match-holowalk.ts  →  scripts/cctv-matches.json
#   scripts/cctv-download-matched.ts →  scripts/cctv-staging/**
/scripts/cctv-matches.json
/scripts/cctv-staging/
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# splat pipeline (staging frames, SHARP outputs, run logs, per-machine config)
tmp/
scripts/cctv-fetch.config.json

# Generic logs (dev server, script runs, tsc temp output)
*.log
dev.log

# Python caches (pulled in via python-services/ and functions/)
__pycache__/
*.pyc

# Playwright + audit artifacts (regenerated by the audit scripts; the
# report markdown is what we keep in version control, not the screenshots
# or raw JSON snapshots)
/tests/audit-wave*/results.json
/tests/audit-wave*/*.png
/tests/e2e/artifacts/

# Google Drive OAuth — bench-only creds, never commit
.gdrive-oauth.json
.gdrive-token.json
